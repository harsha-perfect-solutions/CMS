datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id                  String               @id @default(uuid())
  rollNumber          String               @unique
  name                String
  email               String               @unique
  password            String
  role                String               @default("student")
  status              String               @default("Active") // "Active" | "Inactive" | "Suspended"
  department          String?
  semester            Int?                 @default(6)
  section             String?
  year                Int?
  studentType         String?              // "Day Scholar" | "Hostel" | "College Bus"
  parentId            String?
  parent              Parent?              @relation(fields: [parentId], references: [id])
  cgpa                Float?               @default(8.85)
  creditsEarned       Int?                 @default(112)
  feeStatus           String?              @default("Paid") // "Paid" | "Pending" | "Partial"
  avatarUrl           String?
  courseRegistrations CourseRegistration[]
  nptelRecords        NptelRecord[]
  attendanceRecords   AttendanceRecord[]
  notifications       Notification[]
  placementRecords    PlacementRecord[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([parentId])
}

model Parent {
  id                  String               @id @default(uuid())
  rollNumber          String               @unique
  name                String
  email               String               @unique
  password            String
  role                String               @default("parent")
  status              String               @default("Active") // "Active" | "Inactive" | "Suspended"
  department          String?
  students            Student[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Faculty {
  id                  String               @id @default(uuid())
  rollNumber          String               @unique
  name                String
  email               String               @unique
  password            String
  role                String               @default("faculty") // "hod" or "faculty"
  status              String               @default("Active") // "Active" | "Inactive" | "Suspended"
  department          String?
  timetables          MasterTimetable[]
  payrolls            PayrollRecord[]
  bankDetails         BankDetails[]
  bankChangeRequests  BankChangeRequest[]
  reimbursements      Reimbursement[]
  subjectAllocations  SubjectAllocation[]
  lmsResources        LmsResource[]
  lessonPlans         LessonPlan[]
  leaveRequests       FacultyLeave[]
  leaveBalances       FacultyLeaveBalance[]
  attendanceRecords   AttendanceRecord[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Admin {
  id                  String               @id @default(uuid())
  rollNumber          String               @unique
  name                String
  email               String               @unique
  password            String
  role                String               @default("admin") // "super_admin", "admin", "principal", "vice_principal", "dean", etc.
  status              String               @default("Active") // "Active" | "Inactive" | "Suspended"
  department          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Course {
  id                  String               @id @default(uuid())
  code                String               @unique
  name                String
  faculty             String
  credits             Float
  category            String
  semester            Int
  department          String?
  sections            String?
  isOffered           Boolean              @default(false)
  status              String               @default("Draft")
  courseRegistrations CourseRegistration[]
  nptelRecords        NptelRecord[]
  timetables          MasterTimetable[]
  subjectAllocations  SubjectAllocation[]
  lmsResources        LmsResource[]
  lessonPlans         LessonPlan[]
  attendanceRecords   AttendanceRecord[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model LmsResource {
  id           String   @id @default(uuid())
  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id])
  title        String
  unit         String?  // e.g. "Unit 1", "Unit 2"
  fileUrl      String
  videoUrl     String?
  fileType     String?  // "pdf", "docx", "pptx", "video", etc.
  fileSize     String?  // e.g. "2.4 MB"
  fileName     String?
  mimeType     String?
  resourceType String?  @default("STUDY_NOTE")
  departmentId String?
  isPublished  Boolean  @default(true)
  facultyId    String
  faculty      Faculty  @relation(fields: [facultyId], references: [id])
  lessonPlans  LessonPlan[]
  uploadedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([courseId])
  @@index([facultyId])
}

model CourseRegistration {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  status       String   @default("APPROVED") // "APPROVED" | "PENDING" | "REJECTED"
  registeredAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([courseId])
}

model NptelRecord {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id])
  score          Float    @default(0.0)
  certificateUrl String?
  createdAt      DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([courseId])
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  userId       String
  user         Student          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String           // YYYY-MM-DD
  periodNumber Int?             @default(1)
  status       String           // "Present" | "Absent" | "Late"
  timetableId  String?
  timetable    MasterTimetable? @relation(fields: [timetableId], references: [id], onDelete: SetNull)
  courseId     String?
  course       Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  facultyId    String?
  faculty      Faculty?         @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  remarks      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, date, periodNumber])
  @@index([userId])
  @@index([date])
  @@index([timetableId])
  @@index([facultyId])
  @@index([courseId])
}

model Notification {
  id         String    @id @default(uuid())
  studentId  String?
  student    Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  userId     String?
  role       String?
  title      String
  message    String
  isRead     Boolean   @default(false)
  type       String    @default("INFO")
  priority   String?   @default("Medium") // "High" | "Medium" | "Low"
  senderId   String?
  senderName String?
  senderRole String?
  department String?
  courseCode String?
  entityId   String?   // Batch/Broadcast ID or related entity ID
  link       String?
  metadata   String?
  readAt     DateTime?
  status     String?   @default("Active") // "Active" | "Cancelled"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @default(now()) @updatedAt

  @@index([studentId])
  @@index([userId])
  @@index([role])
  @@index([type])
  @@index([isRead])
  @@index([entityId])
  @@index([department])
}

model ExamNotification {
  id              String    @id @default(uuid())
  batchId         String    @unique @map("batch_id") @db.VarChar(255)
  title           String    @db.VarChar(500)
  message         String
  type            String    @db.VarChar(100)
  priority        String?   @default("High") @db.VarChar(50)
  recipientType   String?   @default("Students") @map("recipient_type") @db.VarChar(50)
  scope           String?   @default("department") @db.VarChar(50)
  department      String?   @default("ALL") @db.VarChar(100)
  academicYear    String?   @default("2026-27") @map("academic_year") @db.VarChar(50)
  semester        Int?
  section         String?   @db.VarChar(50)
  courseCode      String?   @map("course_code") @db.VarChar(100)
  examName        String?   @map("exam_name") @db.VarChar(255)
  examScheduleId  String?   @map("exam_schedule_id") @db.VarChar(255)
  examDate        String?   @map("exam_date") @db.VarChar(100)
  startTime       String?   @map("start_time") @db.VarChar(100)
  endTime         String?   @map("end_time") @db.VarChar(100)
  venue           String?   @db.VarChar(255)
  status          String    @default("DRAFT") @db.VarChar(50)
  scheduledDate   String?   @map("scheduled_date") @db.VarChar(50)
  scheduledTime   String?   @map("scheduled_time") @db.VarChar(50)
  scheduledAt     DateTime? @map("scheduled_at") @db.Timestamp(6)
  publishedAt     DateTime? @map("published_at") @db.Timestamp(6)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamp(6)
  cancelledBy     String?   @map("cancelled_by") @db.VarChar(255)
  cancelReason    String?   @map("cancel_reason")
  totalRecipients Int       @default(0) @map("total_recipients")
  studentCount    Int       @default(0) @map("student_count")
  facultyCount    Int       @default(0) @map("faculty_count")
  senderId        String    @map("sender_id") @db.VarChar(255)
  senderName      String    @map("sender_name") @db.VarChar(255)
  senderRole      String    @map("sender_role") @db.VarChar(100)
  attachmentUrl   String?   @map("attachment_url")
  metadata        String?
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([batchId])
  @@index([department])
  @@index([semester])
  @@index([status])
  @@index([senderId])
  @@map("exam_notifications")
}

model Department {
  id             String          @id @default(uuid())
  name           String          @unique
  code           String          @unique
  hodName        String?
  accreditation  String?         @default("NBA & NAAC A+")
  status         String          @default("Active") // "Active" | "Under Review"
  inventoryItems InventoryItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actorName    String
  actorRole    String
  action       String
  module       String
  targetEntity String?
  targetId     String?
  ipAddress    String?  @default("127.0.0.1")
  status       String   @default("Success") // "Success" | "Failed"
  createdAt    DateTime @default(now())
}

model RolePermission {
  id             String   @id @default(uuid())
  role           String   @unique
  label          String
  isSystemAdmin  Boolean  @default(false)
  isPrincipal    Boolean  @default(false)
  isDean         Boolean  @default(false)
  isHod          Boolean  @default(false)
  isFaculty      Boolean  @default(false)
  isFinance      Boolean  @default(false)
  canManageUsers Boolean  @default(false)
  canExportData  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DelegationRule {
  id             String    @id @default(uuid())
  ruleId         String    @unique // e.g. "DEL-101"
  moduleName     String
  delegatedRole  String
  assignedPerson String
  scope          String
  status         String    @default("Active Delegation") // "Active Delegation" | "Pending Review"
  permissions    String    // Stored as JSON or comma-separated list
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CurriculumScheme {
  id                String   @id @default(uuid())
  regulationCode    String   @unique
  programName       String
  effectiveBatch    String
  totalCredits      Float
  coreTheoryCredits Float
  labCredits        Float
  electiveCredits   Float
  projectCredits    Float
  status            String   @default("Active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MasterTimetable {
  id           String   @id @default(uuid())

  branch       String   // e.g. "CSE", "ECE", "ME", "EEE", "CIVIL", "IT", "AI&DS", "AI&ML"
  semester     Int      // e.g. 1, 3, 5, 7
  section      String   // e.g. "Section A", "Section B"

  day          String   // "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"
  periodNumber Int      // 1 to 8

  startTime    String   // e.g. "09:00 AM"
  endTime      String   // e.g. "10:00 AM"

  academicYear String   @default("2026-27")

  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  facultyId    String?
  faculty      Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  roomNo       String?  // e.g. "Block B - 302"
  isLab        Boolean  @default(false)

  attendanceRecords AttendanceRecord[]
  lessonPlans       LessonPlan[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([branch, semester, section, day, periodNumber])
  @@index([facultyId])
  @@index([courseId])
  @@index([day, periodNumber])
  @@index([academicYear])
  @@index([roomNo, day, periodNumber])
}

model SalaryStructure {
  id               String   @id @default(uuid())
  employeeId       String   @unique
  basicPay         Float    @default(75000)
  da               Float    @default(7500)
  hra              Float    @default(22500)
  medical          Float    @default(2000)
  academic         Float    @default(3000)
  research         Float    @default(2000)
  transport        Float    @default(1500)
  otherAllowances  Float    @default(1000)
  pf               Float    @default(4500)
  profTax          Float    @default(200)
  incomeTax        Float    @default(4000)
  esi              Float    @default(500)
  insurance        Float    @default(1000)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PayrollRecord {
  id                     String            @id @default(uuid())
  employeeId             String
  facultyId              String?
  faculty                Faculty?          @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  employeeName           String
  employeeRollNumber     String?
  department             String
  designation            String
  employeeType           String            @default("Faculty") // "Faculty" | "Staff"
  monthYear              String            // e.g. "July 2026"
  financialYear          String            @default("FY 2026-27") // e.g. "FY 2026-27"
  basicPay               Float
  da                     Float             @default(0)
  hra                    Float             @default(0)
  allowances             Float             @default(0)
  deductions             Float             @default(0)
  grossSalary            Float
  netSalary              Float
  status                 String            @default("Paid") // "Paid" | "Processing" | "Pending Approval" | "HR_VERIFIED" | "FINANCE_REVIEW" | "SUPER_ADMIN_PENDING"
  paymentDate            String?           // YYYY-MM-DD
  bankAccount            String?           // Masked bank account e.g. "HDFC-****-8812"
  paymentReference       String?           // e.g. "TXN-998822"
  earningsJson           String?           // Full JSON breakdown
  deductionsJson         String?           // Full JSON breakdown
  attendanceImpactJson   String?           // Full JSON impact
  approvalRequests       ApprovalRequest[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([employeeId, monthYear])
  @@index([employeeId])
  @@index([facultyId])
  @@index([monthYear])
  @@index([department])
  @@index([status])
}

model BankDetails {
  id                   String   @id @default(uuid())
  employeeId           String   @unique
  facultyId            String?
  faculty              Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  bankName             String   @default("HDFC Bank Ltd")
  accountNumber        String   // Stored in DB, returned masked in APIs
  ifscCode             String   @default("HDFC0000240")
  branch               String   @default("Hitech City, Hyderabad")
  nomineeName          String   @default("Spouse / Dependent")
  salaryCreditAccount  Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([facultyId])
}

model BankChangeRequest {
  id                   String            @id @default(uuid())
  employeeId           String
  facultyId            String?
  faculty              Faculty?          @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  requestedBankName    String
  requestedAccountNumber String
  requestedIfscCode    String
  requestedBranch      String?
  requestedNomineeName String?
  status               String            @default("Pending") // "Pending" | "Approved" | "Rejected" | "HR_VERIFIED" | "FINANCE_REVIEW" | "SUPER_ADMIN_PENDING"
  rejectionReason      String?
  approvalRequests     ApprovalRequest[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([employeeId])
  @@index([facultyId])
  @@index([status])
}

model Reimbursement {
  id             String            @id @default(uuid())
  employeeId     String
  facultyId      String?
  faculty        Faculty?          @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  category       String            // "Travel Allowance" | "Research Grant" | "Book Purchase" | "Conference Expenses" | "Lab Expenses"
  amount         Float
  status         String            @default("Pending") // "Paid" | "Approved" | "Pending" | "Rejected" | "HR_VERIFIED" | "FINANCE_REVIEW" | "SUPER_ADMIN_PENDING"
  claimDate      String            // YYYY-MM-DD
  approvalDate   String?           // YYYY-MM-DD
  remarks        String?
  approvalRequests ApprovalRequest[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([employeeId])
  @@index([facultyId])
  @@index([status])
}

model SubjectAllocation {
  id           String   @id @default(uuid())
  facultyId    String
  faculty      Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  department   String
  semester     String
  section      String
  academicYear String
  weeklyHours  Int      @default(3)
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([courseId, semester, section, academicYear])
  @@index([department])
  @@index([facultyId])
  @@index([courseId])
  @@index([academicYear])
}

model LessonPlan {
  id                  String           @id @default(uuid())
  facultyId           String
  faculty             Faculty          @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  department          String
  semester            Int
  section             String
  academicYear        String           @default("2026-27")
  unitNumber          Int              @default(1)
  unitTitle           String
  topic               String
  subtopic            String?
  plannedDate         String?          // YYYY-MM-DD
  plannedStartTime    String?          // e.g. "09:00 AM"
  plannedEndTime      String?          // e.g. "10:00 AM"
  durationMinutes     Int              @default(60)
  teachingMode        String           @default("Theory") // "Theory" | "Lab" | "Integrated"
  teachingMethod      String           @default("Lecture") // "Lecture" | "Tutorial" | "Laboratory" | "Discussion" | "Demonstration" | "Case Study"
  learningObjectives  String?          // JSON array or text
  plannedActivities   String?          // JSON array or text
  actualActivities    String?          // JSON array or text
  requiredResources   String?
  assessmentMethod    String?
  homeworkAssignment  String?
  status              String           @default("PLANNED") // "DRAFT" | "PLANNED" | "IN_PROGRESS" | "COMPLETED" | "POSTPONED" | "CANCELLED"
  postponedReason     String?
  actualDate          String?
  actualDuration      Int?
  teachingNotes       String?
  topicsCovered       String?
  timetableSessionId  String?
  timetableSession    MasterTimetable? @relation(fields: [timetableSessionId], references: [id], onDelete: SetNull)
  lmsResourceId       String?
  lmsResource         LmsResource?     @relation(fields: [lmsResourceId], references: [id], onDelete: SetNull)
  coveragePercentage  Float            @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([facultyId])
  @@index([courseId])
  @@index([department, semester, section])
  @@index([plannedDate])
  @@index([status])
}

model ExamSchedule {
  id                 String    @id @db.VarChar(255)
  name               String    @db.VarChar(255)
  type               String    @db.VarChar(100)
  department         String    @db.VarChar(100)
  year               Int
  semester           Int
  startDate          String?   @map("start_date") @db.VarChar(100)
  endDate            String?   @map("end_date") @db.VarChar(100)
  status             String    @db.VarChar(100)
  enrollmentDeadline String?   @map("enrollment_deadline") @db.VarChar(100)
  examFee            Decimal?  @map("exam_fee") @db.Decimal(10, 2)
  createdBy          String?   @map("created_by") @db.VarChar(255)
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("exam_schedules")
}

model ApprovalRequest {
  id                   String             @id @default(uuid())
  requestNumber        String             @unique // e.g. "REQ-2026-0801"
  requestType          String             // "PAYROLL" | "REIMBURSEMENT" | "BANK_CHANGE" | "ATTENDANCE" | "LEAVE" | "EXAM" | "FINANCE" | "CLEARANCE" | "SECURITY"
  module               String?            // "ATTENDANCE" | "LEAVE" | "EXAM" | "FINANCE" | "PAYROLL" | "REIMBURSEMENT" | "BANK_ACCOUNT" | "CLEARANCE" | "SECURITY"
  title                String
  description          String?
  amount               Float?             @default(0)

  // Target Entity Linkage (Direct foreign keys & generic references)
  payrollRecordId      String?
  payrollRecord        PayrollRecord?     @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)
  reimbursementId      String?
  reimbursement        Reimbursement?     @relation(fields: [reimbursementId], references: [id], onDelete: SetNull)
  bankChangeRequestId  String?
  bankChangeRequest    BankChangeRequest? @relation(fields: [bankChangeRequestId], references: [id], onDelete: SetNull)
  facultyLeaveId       String?
  facultyLeave         FacultyLeave?      @relation(fields: [facultyLeaveId], references: [id], onDelete: SetNull)
  
  entityType           String?            // e.g. "AttendanceRecord", "FacultyLeave", "ExamGrade", "StudentClearance"
  entityId             String?            // ID of target entity

  // Workflow Engine Details
  workflowCode         String?            // e.g. "ATTENDANCE_MEDICAL_OVERRIDE", "FACULTY_LEAVE", "GRADE_CORRECTION", "PAYROLL_DISBURSEMENT"
  currentStep          Int                @default(1)
  totalSteps           Int                @default(3)
  stepsJson            String?            // JSON string storing ordered step sequence & sign-offs
  metadata             String?            // JSON string storing request context / payload

  // Requester Metadata
  requestedBy          String
  requestedByRole      String             // "faculty" | "staff" | "hr" | "finance" | "student"
  department           String

  // Workflow Stages & Statuses
  currentStage         String             @default("SUBMITTED") // "SUBMITTED" | "HR_VERIFICATION" | "FINANCE_REVIEW" | "SUPER_ADMIN_PENDING" | "FINALIZED"
  status               String             @default("SUBMITTED") // "SUBMITTED" | "PENDING" | "APPROVED" | "REJECTED" | "RETURNED" | "EXECUTED" | "LOCKED"
  priority             String             @default("High")      // "Normal" | "High" | "Critical"

  // 3-Tier Verification Sign-offs & History
  hrVerifiedBy         String?
  hrVerifiedAt         DateTime?
  hrNotes              String?

  financeReviewedBy    String?
  financeReviewedAt    DateTime?
  financeNotes         String?

  superAdminDecisionBy String?
  superAdminDecisionAt DateTime?
  superAdminNotes      String?

  rejectionReason      String?
  returnedToStage      String?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([requestType])
  @@index([currentStage])
  @@index([status])
  @@index([department])
  @@index([module])
  @@index([workflowCode])
  @@index([payrollRecordId])
  @@index([reimbursementId])
  @@index([bankChangeRequestId])
  @@index([facultyLeaveId])
}

model Alumni {
  id                  String             @id @default(uuid())
  alumniId            String             @unique // e.g. "ALM-2020-001"
  name                String
  email               String             @unique
  phone               String?
  batchYear           String             // e.g. "Batch of 2020"
  department          String             // e.g. "Computer Science (CSE)"
  degree              String?            // e.g. "B.Tech in CSE"
  graduationYear      Int                @default(2020)
  currentCompany      String
  designation         String
  industry            String             @default("Technology & Software")
  location            String             // e.g. "Mountain View, CA, USA"
  country             String             // e.g. "USA"
  experienceYears     Int                @default(5)
  skills              String?            // JSON string e.g. ["Go", "Kubernetes"]
  mentoringStatus     String             @default("Active Mentor") // "Active Mentor" | "Open to Referrals" | "Guest Speaker" | "Industry Advisor"
  employmentStatus    String             @default("Employed") // "Employed" | "Entrepreneur" | "Higher Studies" | "Research Fellow"
  profilePhoto        String?
  bio                 String?
  linkedInUrl         String?
  githubUrl           String?
  contributionsTotal  Float              @default(0)
  isVerified          Boolean            @default(true)
  jobs                AlumniJob[]
  referralRequests    ReferralRequest[]
  mentorships         AlumniMentorship[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([batchYear])
  @@index([department])
  @@index([currentCompany])
  @@index([country])
  @@index([mentoringStatus])
}

model AlumniJob {
  id                  String             @id @default(uuid())
  jobId               String             @unique // e.g. "JOB-ALM-001"
  alumniId            String
  alumni              Alumni             @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  company             String
  jobTitle            String
  location            String
  employmentType      String             @default("Full-Time") // "Full-Time" | "Remote" | "Hybrid" | "Contract"
  experienceRequired  String
  ctcRange            String
  skills              String?            // JSON string
  department          String             @default("Computer Science")
  description         String
  applicationUrl      String?
  status              String             @default("Active") // "Active" | "Closed"
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([alumniId])
  @@index([company])
  @@index([department])
}

model ReferralRequest {
  id                  String             @id @default(uuid())
  jobId               String?
  alumniId            String
  alumni              Alumni             @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  studentId           String?
  studentName         String
  studentEmail        String
  resumeUrl           String?
  message             String
  status              String             @default("Pending") // "Pending" | "Accepted" | "Rejected"
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([alumniId])
  @@index([status])
}

model AlumniMentorship {
  id                  String             @id @default(uuid())
  alumniId            String
  alumni              Alumni             @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  domain              String             // e.g. "LLM / AI", "VLSI", "EV Systems", "SaaS Engineering"
  availableSlots      String?            // JSON string
  rating              Float              @default(4.9)
  sessionsCompleted   Int                @default(12)
  status              String             @default("Available") // "Available" | "Busy"
  sessions            MentorshipSession[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([alumniId])
  @@index([domain])
}

model MentorshipSession {
  id                  String             @id @default(uuid())
  mentorshipId        String
  mentorship          AlumniMentorship   @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  studentId           String?
  studentName         String
  scheduledAt         DateTime
  durationMinutes     Int                @default(45)
  meetingUrl          String?
  status              String             @default("Booked") // "Booked" | "Completed" | "Cancelled"
  notes               String?
  rating              Float?
  feedback            String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([mentorshipId])
}

model AlumniEvent {
  id                  String             @id @default(uuid())
  eventId             String             @unique // e.g. "EVT-ALM-001"
  title               String
  description         String
  category            String             @default("Global Reunion") // "Global Reunion" | "Tech Symposium" | "Career Fireside" | "Regional Meetup" | "Workshop"
  eventDate           String
  eventTime           String
  venue               String
  organizer           String             @default("EduSuite Alumni Association")
  speakers            String?            // JSON string
  capacity            Int                @default(500)
  registeredCount     Int                @default(0)
  status              String             @default("Upcoming") // "Upcoming" | "Completed" | "Cancelled"
  registrations       EventRegistration[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([category])
  @@index([status])
}

model EventRegistration {
  id                  String             @id @default(uuid())
  eventId             String
  event               AlumniEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  alumniId            String?
  attendeeName        String
  attendeeEmail       String
  qrToken             String             @unique // e.g. "QR-EVT-99124"
  status              String             @default("Registered") // "Registered" | "Checked-In" | "Cancelled"
  checkedInAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([eventId])
  @@index([qrToken])
}

model AlumniDonation {
  id                  String             @id @default(uuid())
  donationId          String             @unique // e.g. "DON-ALM-001"
  alumniId            String?
  donorName           String
  donorEmail          String
  amount              Float
  currency            String             @default("INR")
  campaign            String             @default("Annual Campus Growth Fund")
  purpose             String             // "Campus Labs" | "Research Grants" | "Student Scholarships" | "General Endowment"
  paymentReference    String
  paymentStatus       String             @default("Success") // "Success" | "Pending" | "Failed"
  donatedAt           DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([purpose])
  @@index([paymentStatus])
}

model AlumniChapter {
  id                  String             @id @default(uuid())
  name                String             @unique // e.g. "Silicon Valley Chapter", "Bengaluru Chapter"
  country             String
  city                String
  coordinatorName     String
  memberCount         Int                @default(1500)
  status              String             @default("Active")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model AlumniFeedback {
  id                      String         @id @default(uuid())
  alumniId                String?
  alumniName              String
  graduationYear          Int
  department              String
  curriculumRating        Int            @default(5) // 1-5
  industryReadinessRating Int            @default(5)
  facultyRating           Int            @default(5)
  placementRating         Int            @default(5)
  infrastructureRating    Int            @default(5)
  comments                String?
  status                  String         @default("Approved") // "Approved" | "Pending Review"
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([department])
  @@index([graduationYear])
}

// ==========================================
// LIBRARY MANAGEMENT ERP MODULE
// ==========================================

model LibraryBook {
  id              String            @id @default(uuid())
  accessionNo     String            @unique // e.g. "GMRIT/2026/0001"
  barcode         String?           @unique
  qrCode          String?
  isbn            String
  title           String
  authors         String[]
  publisher       String
  publishedYear   Int
  edition         String?           @default("1st Edition")
  category        String            // "Computer Science" | "Electronics" | "Mechanical" | "Civil" | "Mathematics" | "General" | "Reference"
  subject         String?
  department      String?
  language        String            @default("English")
  totalCopies     Int               @default(1)
  availableCopies Int               @default(1)
  issuedCopies    Int               @default(0)
  reservedCopies  Int               @default(0)
  lostCopies      Int               @default(0)
  damagedCopies   Int               @default(0)
  callNumber      String?           // e.g. "005.133 COR"
  building        String?           @default("Central Library")
  floor           String?           @default("1st Floor")
  rack            String?           @default("Rack-04")
  shelf           String?           @default("Shelf-B")
  price           Float             @default(0.0)
  status          String            @default("Active") // "Active" | "Archived" | "Under Maintenance"
  source          String            @default("Acquisition") // "Acquisition" | "Donation" | "Grant" | "Manual"
  addedBy         String?           @default("Head Librarian")
  tags            String[]          @default([])
  coverUrl        String?
  description     String?
  copies          BookCopy[]
  borrows         BookBorrow[]
  reservations    BookReservation[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([isbn])
  @@index([category])
  @@index([department])
  @@index([title])
}

model BookCopy {
  id              String            @id @default(uuid())
  bookId          String
  book            LibraryBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  copyNumber      Int
  accessionNo     String            @unique // e.g. "GMRIT/2026/0001-C1"
  barcode         String            @unique
  rfidTag         String?           @unique
  status          String            @default("Available") // "Available" | "Issued" | "Reserved" | "Lost" | "Damaged"
  condition       String            @default("Good") // "Mint" | "Good" | "Slightly Worn" | "Damaged"
  building        String?           @default("Central Library")
  floor           String?           @default("1st Floor")
  rack            String?           @default("Rack-04")
  shelf           String?           @default("Shelf-B")
  borrows         BookBorrow[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([bookId])
  @@index([barcode])
  @@index([status])
}

model BookBorrow {
  id              String            @id @default(uuid())
  bookId          String
  book            LibraryBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  copyId          String?
  copy            BookCopy?         @relation(fields: [copyId], references: [id])
  borrowerId      String            // ID referencing Student.id or Faculty.id or Admin.id
  borrowerType    String            // "Student" | "Faculty" | "Staff"
  borrowerName    String
  borrowerRollNo  String            // Roll / Employee number
  borrowerEmail   String?
  borrowerDept    String?
  issueDate       DateTime          @default(now())
  dueDate         DateTime
  returnDate      DateTime?
  renewCount      Int               @default(0)
  maxRenewals     Int               @default(2)
  status          String            @default("Active") // "Active" | "Returned" | "Overdue" | "Lost"
  returnCondition String?           // "Good" | "Slightly Worn" | "Damaged" | "Lost"
  issuedBy        String            @default("Librarian Desk")
  receivedBy      String?
  remarks         String?
  fines           LibraryFine[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([borrowerId])
  @@index([borrowerRollNo])
  @@index([status])
  @@index([dueDate])
  @@index([bookId])
  @@index([copyId])
}

model BookReservation {
  id              String            @id @default(uuid())
  bookId          String
  book            LibraryBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  memberId        String            // Student.id or Faculty.id
  memberType      String            // "Student" | "Faculty" | "Staff"
  memberName      String
  memberRollNo    String
  requestDate     DateTime          @default(now())
  expiryDate      DateTime
  priority        String            @default("Normal") // "High" | "Normal" | "Low"
  queuePosition   Int               @default(1)
  status          String            @default("Pending") // "Pending" | "Fulfilled" | "Cancelled" | "Expired"
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([bookId])
  @@index([memberId])
  @@index([status])
}

model LibraryFine {
  id              String            @id @default(uuid())
  borrowId        String?
  borrow          BookBorrow?       @relation(fields: [borrowId], references: [id])
  memberId        String
  memberType      String            // "Student" | "Faculty" | "Staff"
  memberName      String
  memberRollNo    String
  bookTitle       String?
  amount          Float
  paidAmount      Float             @default(0.0)
  fineType        String            @default("Overdue") // "Overdue" | "Lost Book" | "Damaged Book"
  status          String            @default("Unpaid") // "Unpaid" | "Paid" | "Waived"
  receiptNo       String?           @unique
  paymentMode     String?           // "Cash" | "UPI" | "Online"
  waiveReason     String?
  waivedBy        String?
  paidAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([memberRollNo])
  @@index([status])
  @@index([borrowId])
}

model LibraryIDCard {
  id              String            @id @default(uuid())
  memberId        String
  memberType      String            // "Student" | "Faculty" | "Staff"
  memberName      String
  memberRollNo    String            @unique
  department      String?
  cardNo          String            @unique
  barcode         String            @unique
  rfidTag         String?
  approvalStatus  String            @default("Pending") // "Pending" | "Approved" | "Rejected"
  handoverStatus  String            @default("Pending") // "Pending" | "HandedOver"
  rejectionReason String?
  issuedAt        DateTime?
  expiryDate      DateTime?
  status          String            @default("Active") // "Active" | "Blocked" | "Lost" | "Replaced"
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([approvalStatus])
  @@index([handoverStatus])
}

model LibraryGateEntry {
  id              String            @id @default(uuid())
  memberId        String
  memberType      String            // "Student" | "Faculty" | "Visitor"
  memberName      String
  memberRollNo    String
  department      String?
  entryTime       DateTime          @default(now())
  exitTime        DateTime?
  purpose         String            @default("Reading / Study") // "Book Issue" | "Reading" | "Digital Lab" | "Discussion"
  method          String            @default("Barcode") // "Barcode" | "RFID" | "Manual"
  gateNumber      String            @default("Main Gate")

  @@index([entryTime])
  @@index([memberRollNo])
}

model ReadingHallSeat {
  id                String          @id @default(uuid())
  seatNo            String          @unique
  zone              String          // "A (Silent Study)" | "B (Digital Lab)" | "C (Discussion)"
  status            String          @default("Available") // "Available" | "Occupied" | "Reserved"
  currentMemberId   String?
  currentMemberName String?
  currentRollNo     String?
  entryTime         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([zone])
  @@index([status])
}

model DigitalResource {
  id              String            @id @default(uuid())
  title           String
  authors         String[]
  resourceType    String            // "Journal" | "Conference Paper" | "E-Book" | "Thesis"
  publisher       String?           // "IEEE" | "Springer" | "ACM" | "Elsevier" | "Oxford"
  publishedYear   Int
  department      String?
  subject         String?
  doi             String?
  isbn            String?
  keywords        String[]          @default([])
  accessLevel     String            @default("Campus Only") // "Campus Only" | "Global"
  fileUrl         String            @default("/resources/sample.pdf")
  downloadCount   Int               @default(0)
  viewCount       Int               @default(0)
  uploadedBy      String            @default("Librarian Staff")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([resourceType])
  @@index([department])
}

model LibraryAcquisition {
  id              String            @id @default(uuid())
  poNumber        String            @unique // e.g. "PO-2026-001"
  vendor          String            // "Pearson India", "Oxford University Press", "McGraw-Hill"
  titlesCount     Int               @default(1)
  totalQuantity   Int               @default(10)
  totalAmount     Float             @default(0.0)
  status          String            @default("Ordered") // "Ordered" | "In Inspection" | "Cataloged" | "Cancelled"
  requestedBy     String            @default("Library Committee")
  invoiceNumber   String?
  deliveryDate    DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
}

model LibraryAuditSession {
  id              String            @id @default(uuid())
  sessionName     String            // e.g. "2026 Annual Central Stock Audit"
  startedBy       String
  startedAt       DateTime          @default(now())
  completedAt     DateTime?
  status          String            @default("InProgress") // "InProgress" | "Completed" | "Cancelled"
  scope           String            @default("All Categories")
  totalScanned    Int               @default(0)
  verified        Int               @default(0)
  missing         Int               @default(0)
  damaged         Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model LibrarySetting {
  id                          String   @id @default("global-library-settings")
  loanPeriodStudentDays       Int      @default(14)
  loanPeriodFacultyDays       Int      @default(30)
  loanPeriodStaffDays         Int      @default(14)
  maxBooksStudent             Int      @default(4)
  maxBooksFaculty             Int      @default(10)
  maxBooksStaff               Int      @default(4)
  finePerDay                  Float    @default(5.0)
  maxFine                     Float    @default(500.0)
  gracePeriodDays             Int      @default(2)
  lostBookMultiplier          Float    @default(2.0)
  damagedBookFine             Float    @default(150.0)
  duplicateCardFee            Float    @default(100.0)
  reservationHoldValidityDays Int      @default(2)
  maxRenewalsAllowed          Int      @default(2)
  renewalExtensionDays        Int      @default(7)
  instituteName               String   @default("EduSuite Pro Central Institute")
  accessionPrefix             String   @default("GMRIT")
  updatedAt                   DateTime @updatedAt
}

// ══════════════════════════════════════════════════════
// ── HOSTEL ERP RELATIONAL DOMAIN MODELS ──
// ══════════════════════════════════════════════════════

model HostelBlock {
  id            String         @id @default(uuid())
  blockCode     String         @unique
  blockName     String
  type          String         // "Boys Hostel" | "Girls Hostel"
  letter        String         // "B" | "G"
  totalCapacity Int            @default(0)
  status        String         @default("Active") // "Active" | "Maintenance"
  floors        HostelFloor[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model HostelFloor {
  id          String         @id @default(uuid())
  blockId     String
  block       HostelBlock    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  floorNumber Int
  floorName   String
  status      String         @default("Active")
  rooms       HostelRoom[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([blockId, floorNumber])
}

model HostelRoom {
  id                String                 @id @default(uuid())
  floorId           String
  floor             HostelFloor            @relation(fields: [floorId], references: [id], onDelete: Cascade)
  roomNumber        String
  roomType          String                 @default("Triple Sharing") // "Single" | "Double" | "Triple Sharing" | "Four Sharing"
  capacity          Int                    @default(3)
  occupiedCount     Int                    @default(0)
  status            String                 @default("AVAILABLE") // "AVAILABLE" | "OCCUPIED" | "MAINTENANCE"
  maintenanceReason String?
  beds              HostelBed[]
  guestStays        HostelGuestStay[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([floorId, roomNumber])
}

model HostelBed {
  id          String                 @id @default(uuid())
  roomId      String
  room        HostelRoom             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bedNumber   String
  status      String                 @default("AVAILABLE") // "AVAILABLE" | "OCCUPIED" | "RESERVED"
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([roomId, bedNumber])
}

model HostelRoomAllocation {
  id             String       @id @default(uuid())
  studentId      String
  registrationId String?
  studentName    String
  rollNumber     String
  blockId        String
  blockName      String?      @default("Boys Hostel")
  floorId        String
  floorName      String?      @default("Floor 1")
  roomId         String
  roomNumber     String?      @default("103")
  bedId          String
  bedNumber      String?      @default("Bed-3")
  allocationDate DateTime     @default(now())
  vacatedDate    DateTime?
  status         String       @default("ACTIVE") // "ACTIVE" | "ALLOCATED" | "VACATED" | "TRANSFERRED" | "CANCELLED"
  allocatedBy    String       @default("Chief Warden")
  remarks        String?      @default("Room and bed assigned upon verification.")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model HostelBiometricDevice {
  id             String                 @id @default(uuid())
  deviceName     String
  deviceCode     String                 @unique
  location       String
  ipAddress      String
  deviceType     String                 // "Biometric Turnstile" | "Fingerprint" | "RFID Gate" | "Face Recognition"
  status         String                 @default("ONLINE") // "ONLINE" | "OFFLINE" | "MAINTENANCE"
  lastHeartbeat  DateTime               @default(now())
  events         HostelAttendanceEvent[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model HostelMovementLog {
  id                  String   @id @default(uuid())
  studentId           String
  registrationId      String?
  studentName         String
  allocationId        String?
  outingId            String?
  blockName           String
  floorName           String?  @default("Floor 1")
  roomNumber          String
  bedNumber           String?
  movementType        String   // "CHECK-IN" | "CHECK-OUT" | "UNAUTHORIZED_EXIT" | "EMERGENCY_EXIT"
  timestamp           DateTime @default(now())
  deviceId            String?
  deviceName          String   @default("Main Gate Biometric Turnstile")
  method              String   @default("Fingerprint") // "Fingerprint" | "RFID" | "Face" | "Manual" | "QR"
  authorizationStatus String   @default("AUTHORIZED") // "AUTHORIZED" | "UNAUTHORIZED"
  status              String   @default("NORMAL") // "NORMAL" | "LATE" | "VIOLATION" | "COMPLETED"
  remarks             String?
  createdAt           DateTime @default(now())
}

model HostelOutingRecord {
  id                 String    @id @default(uuid())
  studentId          String
  registrationId     String?
  studentName        String
  blockName          String
  floorName          String?   @default("Floor 1")
  roomNumber         String
  bedNumber          String?
  outingRequestId    String?
  outingDate         String    @default("26-08-2026")
  reason             String
  approvedBy         String    @default("Warden")
  expectedOutTime    String    @default("05:00 PM")
  actualOutTime      String?
  expectedReturnTime String    @default("08:00 PM")
  actualReturnTime   String?
  graceMinutes       Int       @default(60)
  allowedUntilTime   String?   @default("09:00 PM")
  durationText       String?
  status             String    @default("OUTSIDE") // "OUTSIDE" | "RETURNED" | "OVERDUE"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model HostelMovementViolation {
  id                 String    @id @default(uuid())
  studentId          String
  registrationId     String?
  studentName        String
  blockName          String
  floorName          String?   @default("Floor 1")
  roomNumber         String
  bedNumber          String?
  outingId           String?
  gateLogId          String?
  outingDate         String    @default("26-08-2026")
  reason             String?
  expectedReturnTime String?   @default("08:00 PM")
  graceMinutes       Int       @default(60)
  allowedUntilTime   String?   @default("09:00 PM")
  actualReturnTime   String?
  lateMinutes        Int       @default(0)
  lateDurationText   String?
  violationType      String    @default("Late Return") // "Late Return" | "Missing Return / Overdue" | "Unauthorized Exit" | "Curfew Breach"
  severity           String    @default("HIGH") // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  status             String    @default("OPEN") // "OPEN" | "REVIEWED" | "RESOLVED"
  actionTaken        String?
  remarks            String?
  resolvedBy         String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
}

model HostelAttendanceEvent {
  id                 String                 @id @default(uuid())
  studentName        String
  userId             String
  blockName          String
  floorName          String
  roomNumber         String
  deviceId           String?
  device             HostelBiometricDevice? @relation(fields: [deviceId], references: [id])
  deviceName         String                 @default("Girls Hostel Biometric")
  eventType          String                 @default("CHECK-IN") // "CHECK-IN" | "CHECK-OUT"
  method             String                 @default("Fingerprint") // "Fingerprint" | "RFID" | "Face" | "Manual"
  timestamp          DateTime               @default(now())
  verificationStatus String                 @default("VERIFIED")
  violations         HostelViolation[]
  createdAt          DateTime               @default(now())
}

model HostelViolation {
  id                String                 @id @default(uuid())
  studentName       String
  userId            String
  outingId          String?
  attendanceEventId String?
  attendanceEvent   HostelAttendanceEvent? @relation(fields: [attendanceEventId], references: [id])
  violationType     String                 // "LATE_RETURN" | "UNAUTHORIZED_EXIT" | "UNAUTHORIZED_ENTRY" | "OVERSTAY" | "CURFEW_BREACH"
  description       String
  severity          String                 @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  status            String                 @default("OPEN") // "OPEN" | "REVIEWED" | "RESOLVED" | "PENALIZED"
  remarks           String?
  detectedAt        DateTime               @default(now())
  resolvedAt        DateTime?
  resolvedBy        String?
}

model HostelMealSlot {
  id        String                 @id @default(uuid())
  name      String                 @unique // "Breakfast" | "Lunch" | "Snacks" | "Dinner"
  timeRange String                 // "07:30 - 09:15"
  startTime String                 // "07:30"
  endTime   String                 // "09:15"
  status    String                 @default("Active")
  menus     HostelMenuSchedule[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model HostelMenuSchedule {
  id              String          @id @default(uuid())
  dateString      String          // "26 Aug 2026"
  dayName         String          // "Wednesday"
  mealSlotId      String?
  mealSlot        HostelMealSlot? @relation(fields: [mealSlotId], references: [id])
  breakfastNonVeg Boolean         @default(false)
  lunchNonVeg     Boolean         @default(false)
  snacksNonVeg    Boolean         @default(false)
  dinnerNonVeg    Boolean         @default(false)
  notes           String?         @default("")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([dateString])
}

model HostelOutingRequest {
  id             String                 @id @default(uuid())
  studentName    String
  studentId      String
  destination    String?
  fromDate       String
  toDate         String
  reason         String
  status         String                 @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "OUT" | "RETURNED"
  parentApproval String                 @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  wardenApproval String                 @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  requestedAt    DateTime               @default(now())
  approvals      HostelOutingApproval[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model HostelOutingApproval {
  id              String              @id @default(uuid())
  outingRequestId String
  outingRequest   HostelOutingRequest @relation(fields: [outingRequestId], references: [id], onDelete: Cascade)
  approverId      String
  approverRole    String              // "PARENT" | "WARDEN" | "SECURITY"
  action          String              // "APPROVED" | "REJECTED"
  comments        String?
  actionAt        DateTime            @default(now())
}

model HostelLeaveRequest {
  id             String   @id @default(uuid())
  studentName    String
  studentId      String
  leaveType      String   // "Home Visit" | "Medical" | "Academic / Internship" | "Emergency"
  startDate      String
  endDate        String
  state          String   @default("Active")
  status         String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  parentApproval String   @default("PENDING")
  createdBy      String   @default("Student")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HostelSuspension {
  id          String   @id @default(uuid())
  studentName String
  studentId   String
  reason      String
  fromDate    String
  toDate      String
  status      String   @default("ACTIVE") // "ACTIVE" | "REVOKED" | "EXPIRED"
  approvedBy  String   @default("Chief Warden")
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HostelGuest {
  id        String            @id @default(uuid())
  guestName String
  phone     String
  email     String?
  relation  String            // "Father" | "Mother" | "Guardian" | "Official Guest"
  idProof   String?
  stays     HostelGuestStay[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model HostelGuestStay {
  id        String            @id @default(uuid())
  guestId   String
  guest     HostelGuest       @relation(fields: [guestId], references: [id], onDelete: Cascade)
  roomId    String?
  room      HostelRoom?       @relation(fields: [roomId], references: [id])
  checkIn   String
  checkOut  String
  status    String            @default("ACTIVE") // "ACTIVE" | "COMPLETED" | "CANCELLED"
  bills     HostelGuestBill[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model HostelGuestBill {
  id            String          @id @default(uuid())
  guestStayId   String
  guestStay     HostelGuestStay @relation(fields: [guestStayId], references: [id], onDelete: Cascade)
  guestName     String
  contactNumber String
  purpose       String
  fromDate      String
  toDate        String
  roomCharges   Float           @default(0)
  messCharges   Float           @default(0)
  extraCharges  Float           @default(0)
  totalAmount   Float           @default(0)
  paymentStatus String          @default("PAID") // "PAID" | "PENDING" | "WAIVED"
  invoiceNumber String          @unique
  generatedAt   DateTime        @default(now())
}

model HostelAuditLog {
  id         String   @id @default(uuid())
  userId     String
  userName   String
  action     String   // "CREATE_BLOCK" | "ALLOCATE_ROOM" | "APPROVE_OUTING" | "GENERATE_BILL" | "VIOLATION_TRIGGER"
  module     String   // "BLOCKS" | "ALLOCATION" | "OUTING" | "BILLING" | "ATTENDANCE" | "MESS"
  entityType String
  entityId   String
  details    String?
  ipAddress  String?
  timestamp  DateTime @default(now())
}

model HostelRegistration {
  id                      String    @id @default(uuid())
  applicationId           String?   @unique // e.g. STU2026CSE001
  fullName                String
  registrationNumber      String    @unique
  dateOfBirth             String
  gender                  String
  bloodGroup              String?
  profilePhoto            String?
  permanentAddress        String
  city                    String
  district                String?
  state                   String
  pincode                 String
  
  // Contact Information
  mobileNumber            String
  alternateNumber         String?
  email                   String
  parentName              String
  parentContact           String
  parentEmail             String?
  guardianName            String?
  guardianMobileNumber    String?
  guardianEmail           String?
  emergencyContact        String
  
  // Academic Information
  college                 String?   @default("Campus Institute of Technology")
  course                  String
  department              String
  yearOfStudy             String
  semester                String
  section                 String?   @default("A")
  admissionNumber         String?
  
  // Medical Information
  medicalConditions       String?
  allergies               String?
  emergencyMedicalInfo    String?
  specialRequirements     String?
  medications             String?
  
  // Hostel Preferences
  hostelRequired          Boolean   @default(true)
  preferredBlock          String?
  roomTypePreference      String?
  specialAccommodationReq String?
  preferredRoomId         String?
  
  // Status & Allocation Details
  status                  String    @default("PENDING_ALLOCATION") // "PENDING_ALLOCATION" | "ALLOCATED" | "REJECTED"
  allocatedBlockId        String?
  allocatedBlockName      String?
  allocatedFloorId        String?
  allocatedFloorName      String?
  allocatedRoomId         String?
  allocatedRoomNumber     String?
  allocatedBedId          String?
  allocatedBedNumber      String?
  allocatedAt             DateTime?
  allocatedBy             String?
  rejectionReason         String?
  agreeTerms              Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

/// Campus placement / recruitment drive.
/// eligibleDepts is comma-separated dept codes, e.g. "CSE,ECE,AI&DS" or "ALL".
model PlacementDrive {
  id               String            @id @default(uuid())
  companyName      String
  jobRole          String
  ctcLpa           Float             @default(0)
  driveDate        String            // ISO date YYYY-MM-DD
  location         String?
  eligibleDepts    String?           // Comma-separated: "CSE,ECE" or "ALL"
  status           String            @default("Upcoming") // "Upcoming" | "Ongoing" | "Completed"
  totalApplicants  Int               @default(0)
  selectedCount    Int               @default(0)
  placementRecords PlacementRecord[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
}

/// Confirmed placement offer for a specific student.
/// Department scope is enforced via student.department — never hardcoded.
model PlacementRecord {
  id                String          @id @default(uuid())
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  companyName       String
  jobRole           String
  ctcLpa            Float           @default(0)
  offerDate         String?         // ISO date YYYY-MM-DD
  offerLetterStatus String          @default("Issued") // "Issued" | "Accepted" | "Pending Verification"
  driveId           String?
  drive             PlacementDrive? @relation(fields: [driveId], references: [id], onDelete: SetNull)
  remarks           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([studentId])
  @@index([driveId])
}

/// Inventory and Asset Tracking model for academic departments and institution facilities.
/// Department scope is enforced via departmentId/department code — HOD sees only their department assets.
model InventoryItem {
  id              String      @id @default(uuid())
  assetTag        String?     @unique // e.g. "INV-101"
  name            String
  category        String      // "IT Hardware" | "Lab Equipment" | "Furniture" | "Stationery" | "Sports Gear"
  departmentId    String?
  departmentRef   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  department      String      // Department code e.g. "CSE", "ECE", "ME", "CIVIL", "EEE", "IT", "AI&ML", "AI&DS", or "INSTITUTION"
  location        String      // Descriptive location e.g. "CSE Lab 3 (Block A)"
  building        String?     // e.g. "Block A"
  room            String?     // e.g. "Lab 3"
  roomType        String?     // "Lab" | "Classroom" | "Office" | "Store" | "Facility"
  serialNumber    String?
  quantity        Int         @default(0)
  minThreshold    Int         @default(5)
  unitCost        Float       @default(0)
  status          String      @default("In Stock") // "In Stock" | "Low Stock" | "Out of Stock" | "Under Maintenance"
  assignedTo      String?     // Faculty/staff name or ID
  lastRestockedOn String?     // YYYY-MM-DD
  purchaseDate    String?     // YYYY-MM-DD
  vendor          String?
  remarks         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([department])
  @@index([departmentId])
  @@index([category])
  @@index([status])
}

model FacultyLeave {
  id                  String             @id @default(uuid())
  requestNumber       String             @unique // e.g. "LV-2026-001"
  facultyId           String
  faculty             Faculty            @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  academicYear        String             @default("2026-27")
  department          String
  leaveType           String             // "Casual Leave" | "Sick Leave" | "Earned Leave" | "Duty Leave"
  startDate           String             // "YYYY-MM-DD"
  endDate             String             // "YYYY-MM-DD"
  days                Float              @default(1.0)
  isHalfDay           Boolean            @default(false)
  halfDaySession      String?            // "Morning" | "Afternoon"
  reason              String
  emergencyContact    String?
  additionalNotes     String?
  attachmentName      String?
  attachmentUrl       String?
  status              String             @default("SUBMITTED") // "SUBMITTED" | "HOD_REVIEW" | "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED" | "WITHDRAWN"
  rejectionReason     String?
  approvedBy          String?
  approvedAt          DateTime?
  timetableConflicts  String?            // JSON string of affected timetable slots [{ date, courseCode, courseName, section, time, room }]
  approvalRequests    ApprovalRequest[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([facultyId])
  @@index([status])
  @@index([academicYear])
  @@index([startDate])
}

model FacultyLeaveBalance {
  id                  String             @id @default(uuid())
  facultyId           String
  faculty             Faculty            @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  academicYear        String             @default("2026-27")
  leaveType           String             // "Casual Leave" | "Sick Leave" | "Earned Leave" | "Duty Leave"
  entitlement         Float              @default(12.0)
  used                Float              @default(0.0)
  pending             Float              @default(0.0)
  color               String?            @default("bg-blue-500")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([facultyId, academicYear, leaveType])
  @@index([facultyId])
  @@index([academicYear])
}
